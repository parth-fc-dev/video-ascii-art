{
  "manifest_version": 3,
  "name": "YouTube ASCII",
  "version": "1.0.0",
  "description": "Turn YouTube playback into a live ASCII video overlay.",
  "permissions": ["storage", "activeTab", "downloads"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "YouTube ASCII",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["gpu-renderer.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
